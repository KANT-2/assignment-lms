# 저장소 내 텍스트 파일은 LF 로 통일 (Windows 팀원 CRLF 자동 변환 방지)
* text=auto eol=lf

*.py    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.docx  binary
*.ipynb binary

