# .env.example
# 실제 값을 채워 .env 로 복사해서 사용 (.env 는 git 에 커밋하지 않음)

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- 이 프로젝트 전용 PostgreSQL DB ---
DB_NAME=assignment_lms
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- AX2 통합 플랫폼 DB (ax_evaluation) ---
# 실제 로그인·팀 조회에 필요. 비밀번호는 보안 채널로 별도 전달받은 값.
# (DEV_SKIP_AUTH=True 면 이 DB 없이도 가짜 데이터로 동작)
ACCOUNTS_DB_NAME=ax_evaluation
ACCOUNTS_DB_USER=ax_evaluation
ACCOUNTS_DB_PASSWORD=change-me
ACCOUNTS_DB_HOST=10.2.16.91
ACCOUNTS_DB_PORT=5432
# 우리 강의 라운드 고정 (비우면 IN_PROGRESS 라운드 자동)
# AX_ROUND_ID=61

# --- 개발 폴백: 로그인/AX DB 우회 ---
# 평소엔 False (실제 계정으로 로그인). 오프라인이거나 테스트 돌릴 때만 True.
DEV_SKIP_AUTH=False
DEV_ROLE=TUTOR          # DEV_SKIP_AUTH=True 일 때만 의미. TUTOR | STUDENT

# --- 미디어(제출 파일) ---
MEDIA_ROOT=media

# --- AI 1차 평가 (FR-012, Gemini) ---
# https://aistudio.google.com/apikey 에서 발급. 비우면 AI 채점 시 "생성 실패" 메시지가 뜬다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 1순위 모델이 혼잡(5xx)일 때 순서대로 재시도할 폴백 모델 (쉼표 구분). 비우면 재시도 안 함.
GEMINI_FALLBACK_MODELS=gemini-flash-latest

# --- GitHub 제출물 동기화 (apps.github_sync) ---
# 학생이 제출한 파일을 학생 본인 GitHub 저장소(public, 기본 lms-assignments)에 자동 커밋.
# 아래 3개(CLIENT_ID/SECRET/ENC_KEY)가 모두 있어야 기능이 켜진다. 비우면 완전 no-op.
#   OAuth App 등록: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#     Authorization callback URL = http://localhost:8000/github/callback/  (배포 시 실제 호스트)
#   토큰 암호화 키 생성:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   배포 시 cron/systemd 로 5분마다: python manage.py github_sync
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN_ENC_KEY=
GITHUB_SUBMISSION_REPO_NAME=lms-assignments

# AI 채점(ai_gemini)이 학생 GitHub 공개 레포 단일 파일 링크를 읽을 때 rate limit 상향용.
# 없어도 동작함 (무인증, 시간당 60회). classic token, scope 전부 비워서 발급하면 됨.
GITHUB_API_TOKEN=

# --- Slack 알림 (apps.notifications.slack) ---
# 제출 독려 등에서 사용. 둘 다 비우면 알림은 no-op (기능은 정상 동작).
#   SLACK_WEBHOOK_URL : 채널 알림용 Incoming Webhook URL
#   SLACK_BOT_TOKEN   : 학생 개인 DM 용 봇 토큰(xoxb-). conversations.open + chat.postMessage
#                       스코프: chat:write, im:write. DM 대상은 notifications_slackidentity 매핑.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# --- 아래는 prod(config.settings.prod)에서만 사용 ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
