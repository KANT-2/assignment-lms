# .env.example
# 실제 값을 채워 .env 로 복사해서 사용 (.env 는 git 에 커밋하지 않음)

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- 이 프로젝트 전용 PostgreSQL DB ---
DB_NAME=assignment_lms
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- 외부 계정/팀 DB (읽기 전용, managed=False 모델용) ---
# 개발 단계에서 DEV_SKIP_AUTH=True 면 이 DB 없이도 동작한다 (services.py 가 가짜 데이터 반환).
ACCOUNTS_DB_NAME=accounts
ACCOUNTS_DB_USER=readonly
ACCOUNTS_DB_PASSWORD=change-me
ACCOUNTS_DB_HOST=127.0.0.1
ACCOUNTS_DB_PORT=5432

# --- 개발 전용: 로그인 우회 (인증 방식 확정 전까지) ---
# True 면 로그인 화면 없이 화면 확인 가능. prod 에서는 절대 True 금지.
DEV_SKIP_AUTH=True
DEV_ROLE=TUTOR          # TUTOR | STUDENT — 어떤 역할 화면을 볼지 (바꾸면 서버 재시작)

# --- 미디어(제출 파일) ---
MEDIA_ROOT=media

# --- 아래는 prod(config.settings.prod)에서만 사용 ---
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
